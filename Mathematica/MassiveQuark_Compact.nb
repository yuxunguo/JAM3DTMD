Notebook[{

Cell[CellGroupData[{
Cell["Massive-Quark Cross-Checks: Compact Package Version", "Title",ExpressionUUID->"3df60322-d3a5-bb48-b2e1-10a6ce936ee2"],

Cell["\<\
Explicit Dirac traces and projector calculations for the accompanying note\
\>", "Subtitle",ExpressionUUID->"c287905c-3284-294f-a803-7fa20fa0c2e7"],

Cell["\<\
The low-level Dirac algebra, light-cone basis, dual projectors, and repeated \
simplification rules are wrapped in MassiveQuarkChecks.wl. The notebook below \
keeps the explicit physics calculations visible. Evaluate the notebook from \
top to bottom.\
\>", "Text",ExpressionUUID->"bc73bfd5-d9a1-1644-a829-7702839b0fad"],

Cell[CellGroupData[{

Cell["1. Load the package", "Section",ExpressionUUID->"9cd2cb6e-18db-4447-a41b-bdeb846e0039"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Get", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], ",", 
       " ", "\"\<MassiveQuarkChecks.wl\>\""}], "}"}], "]"}], "]"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "s", ",", " ", "m", ",", " ", "\[Theta]", ",", " ", "kr", ",", " ", "kn", ",",
     " ", "kbr", ",", " ", "kbn", ",", " ", "\[Epsilon]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{"BornAssumptions", "[", 
    RowBox[{"s", ",", " ", "m", ",", " ", "\[Theta]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"cad71940-4bbe-e447-adba-6b8bd088b445"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Explicit unpolarized Born trace", "Section",ExpressionUUID->"b7a62e19-fbaa-194e-aceb-95cf2861426c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kin", " ", "=", " ", 
    RowBox[{"BornKinematics", "[", 
     RowBox[{"s", ",", " ", "m", ",", " ", "\[Theta]"}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rawBorn", " ", "=", "\n", "  ", 
    RowBox[{"BornKernel", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"Slash4", "[", 
        RowBox[{"kin", "[", "\"\<k\>\"", "]"}], "]"}], " ", "+", " ", 
       RowBox[{"m", " ", 
        RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"Slash4", "[", 
        RowBox[{"kin", "[", "\"\<kbar\>\"", "]"}], "]"}], " ", "-", " ", 
       RowBox[{"m", " ", 
        RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], ",", "\n", "    ", 
      "kin"}], "\n", "  ", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"FullSimplify", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"TrigReduce", "[", 
    RowBox[{"rawBorn", "/", 
     RowBox[{"s", "^", "2"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Assumptions", " ", "->", " ", "$Assumptions"}]}], "\n", 
  "]"}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"fa8b95b8-3982-584c-8030-49524304533b"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"4", " ", 
    SuperscriptBox["m", "2"]}], "+", 
   RowBox[{"3", " ", "s"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", 
       SuperscriptBox["m", "2"]}], "+", "s"}], ")"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"2", " ", "\[Theta]"}], "]"}]}]}], 
  RowBox[{"2", " ", "s"}]]], "Output",
 CellChangeTimes->{{3.994257470924244*^9, 3.994257477079645*^9}},
 CellLabel->"Out[9]=",ExpressionUUID->"31afd063-b715-f44c-b083-e57491611091"]
}, Open  ]],

Cell["\<\
Expected output:
1 + Cos[\[Theta]]^2 + (4 m^2/s) Sin[\[Theta]]^2.
This is A_U=A_0+\[Rho]_m B_0.\
\>", "Text",ExpressionUUID->"d4f72a6f-b47c-1f4b-8173-4fa2167a0ff1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"born", " ", "=", " ", 
   RowBox[{"ExactBornCalculation", "[", 
    RowBox[{"s", ",", " ", "m", ",", " ", "\[Theta]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"born", " ", "//", " ", "Dataset"}]}], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"364281c3-bf49-4047-b832-90ae66cfe0d7"],

